# PRODUCTION — DISABLED until explicitly approved. Secrets come from the deployment secret manager, never from Git.
# Live payment mode requires recorded go-live approvals (PSP, LEGAL, ACCOUNTING, SECURITY) and an explicit change by the owner.
APP_ENV=production
APP_PORT=8080
MYSQL_DSN=CHANGE_ME
JWT_SECRET=CHANGE_ME
CORS_ALLOWED_ORIGINS=CHANGE_ME
AUTH_RATE_LIMIT_PER_MIN=30
FINANCIAL_TRANSACTIONS_ENABLED=false
PAYMENT_PROVIDER=mock
SUPPLIER_MODE=mock
MOCK_PSP_SECRET=CHANGE_ME
