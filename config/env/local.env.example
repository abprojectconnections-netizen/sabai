# LOCAL — development only. Safe to commit: no real secrets, no real endpoints.
APP_ENV=development
APP_PORT=8088
MYSQL_DSN=travel:travel@tcp(127.0.0.1:3308)/travel_super_app?parseTime=true&charset=utf8mb4
JWT_SECRET=dev-only-secret-change-me-0123456789
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
AUTH_RATE_LIMIT_PER_MIN=30
# Payments: sandbox only. The mock provider moves no money; /dev/payments/simulate exists only outside production.
FINANCIAL_TRANSACTIONS_ENABLED=true
PAYMENT_PROVIDER=mock
SUPPLIER_MODE=mock
MOCK_PSP_SECRET=dev-psp-secret
