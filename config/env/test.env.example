# TEST — automated tests and CI. A disposable database that may be wiped at any time.
APP_ENV=test
APP_PORT=8089
MYSQL_DSN=root:root@tcp(127.0.0.1:3306)/travel_ci?parseTime=true&charset=utf8mb4
MYSQL_TEST_DSN=root:root@tcp(127.0.0.1:3306)/travel_ci?parseTime=true
JWT_SECRET=test-only-secret-0123456789-abcdef
AUTH_RATE_LIMIT_PER_MIN=0
FINANCIAL_TRANSACTIONS_ENABLED=true
PAYMENT_PROVIDER=mock
SUPPLIER_MODE=mock
MOCK_PSP_SECRET=test-psp-secret
