# PRODUCTION — copy to .env.production (git-ignored) or provide these variables in the release pipeline.
# The build fails at startup (ConfigError screen) unless the API URL is https and not localhost.
VITE_APP_ENV=production
VITE_API_MODE=production
VITE_API_BASE_URL=https://api.example.invalid/api/v1
VITE_BUILD_ID=
